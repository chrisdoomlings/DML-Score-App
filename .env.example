# Shopify App credentials (Partner Dashboard -> App -> App setup)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Deployed app URL (no trailing slash)
HOST=https://dml-score.vercel.app

# Session cookie signing secret — random 32+ char string
SESSION_SECRET=change-me-to-a-random-secret-32chars

# Supabase Postgres — use the session pooler URL for app runtime.
# IMPORTANT: this must be a NEW Supabase project, dedicated to DML Score.
# Do NOT point this at the Reviews & Rewards / Scavenger databases.
SUPABASE_DATABASE_URL=postgresql://postgres.YOURPROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
